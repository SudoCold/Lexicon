{
  "name": "lexicon-desktop",
  "productName": "Lexicon",
  "version": "1.0.0",
  "private": true,
  "description": "An offline vocabulary practice desktop app for curious minds.",
  "author": "Lexicon",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --configLoader runner",
    "desktop": "node scripts/setup-desktop.mjs && npm run build && electron .",
    "build": "tsc -b && vite build --configLoader runner",
    "data:build": "node scripts/build-wordbank.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "package": "node scripts/setup-desktop.mjs && npm run build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@fontsource/dm-sans": "^5.2.0",
    "@fontsource/lora": "^5.2.0",
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "45.5.0",
    "electron-builder": "26.18.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "wordnet-db": "3.1.14"
  },
  "build": {
    "appId": "com.lexicon.vocabulary",
    "productName": "Lexicon",
    "electronDist": "node_modules/electron/dist",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "shared/**/*", "package.json"],
    "win": { "target": "nsis", "icon": "build/icon.ico", "signExecutable": false },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true, "installerIcon": "build/icon.ico" },
    "artifactName": "Lexicon-Setup-${version}.${ext}"
  }
}
